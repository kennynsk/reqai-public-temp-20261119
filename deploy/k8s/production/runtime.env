# Non-secret production inputs. Replace every replace-* value before validation.
# This file is read by Kustomize only; .env.dev and shell credentials are never loaded.
NODE_ENV=production
ASYNC_PLATFORM_ENABLED=true
AUTH_ENABLED=true
PORT=5178
WORKER_HEALTH_PORT=8081
DEPLOYMENT_SITE_ID=replace-site-id
DEFAULT_TENANT_ID=replace-tenant-id
LOG_LEVEL=info
IAM_ISSUER=https://replace-iam-host.invalid
IAM_AUDIENCE=replace-iam-audience
IAM_JWKS_URI=https://replace-iam-host.invalid/.well-known/jwks.json
IAM_USER_ID_CLAIM=sub
IAM_ROLES_CLAIM=roles
IAM_TENANT_CLAIM=tenant_id
IAM_DEFAULT_TENANT_ALLOWED=false
IAM_ROLE_MAPPING_JSON={"user":["reqai-user"],"tenant-admin":["reqai-tenant-admin"],"operator":["reqai-operator"],"auditor":["reqai-auditor"],"system-admin":["reqai-system-admin"]}
DATABASE_SCHEMA=reqai
DATABASE_ARTIFACT_SCHEMA=reqai_artifacts
DATABASE_SSL_MODE=verify-full
DATABASE_CA_CERT_PATH=/etc/reqai/trust/postgres-ca.crt
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
NODE_EXTRA_CA_CERTS=/etc/reqai/trust/node-ca.pem
KAFKA_BROKERS=replace-kafka-host.invalid:9093
KAFKA_SSL_ENABLED=true
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_JOB_EVENTS_TOPIC=replace-prod-job-events
KAFKA_WEBHOOK_DLQ_TOPIC=replace-prod-webhook-dlq
TEMPORAL_ADDRESS=replace-temporal-host.invalid:7233
TEMPORAL_NAMESPACE=replace-prod-namespace
TEMPORAL_TLS_ENABLED=true
TEMPORAL_TLS_CERT_PATH=/var/run/secrets/temporal/tls.crt
TEMPORAL_TLS_KEY_PATH=/var/run/secrets/temporal/tls.key
TEMPORAL_TLS_CA_CERT_PATH=/etc/reqai/trust/temporal-ca.crt
TEMPORAL_TLS_SERVER_NAME=replace-temporal-host.invalid
TEMPORAL_TASK_QUEUE_DECOMPOSITION=requirements-decomposition
TEMPORAL_TASK_QUEUE_RESEARCH=requirements-research
TEMPORAL_WORKFLOW_BUILD_ID=replace-release-id
API_SHUTDOWN_GRACE_MS=30000
WORKER_SHUTDOWN_GRACE_MS=600000
LLM_PROVIDER_MODE=zai
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# Confirm models and paid account quotas; these are not advertised provider limits.
ZAI_MODELS=glm-5.3-flash
LLM_MODEL_PRIORITY=glm-5.3-flash
LLM_MODEL_RPM_JSON={"glm-5.3-flash":0}
LLM_MODEL_TPM_JSON={"glm-5.3-flash":0}
LLM_MODEL_MAX_CONCURRENCY_JSON={"glm-5.3-flash":0}
ADMISSION_MAX_JOBS_PER_MINUTE=30
VERSIONED_PROMPTS_ENABLED=true
REQUIREMENTS_INTEGRATION_API_ENABLED=true
PROMPT_DECOMPOSITION_ACTIVE_VERSION=2.17.0
PROMPT_DECOMPOSITION_RELEASED_VERSIONS=2.17.0
PROMPT_REQUIREMENTS_INSIGHTS_ACTIVE_VERSION=2.15.0
PROMPT_REQUIREMENTS_INSIGHTS_RELEASED_VERSIONS=2.15.0
SKILL_BABOK_REQUIREMENTS_ACTIVE_VERSION=1.0.0
SKILL_BABOK_REQUIREMENTS_RELEASED_VERSIONS=1.0.0
DIAGNOSTIC_CAPTURE_PROTECTED=false
WEBHOOK_ENABLED=false
RETENTION_FINAL_RESULTS_DAYS=180
RETENTION_CHECKPOINTS_AFTER_COMPLETION_DAYS=30
RETENTION_INTERMEDIATE_RESULTS_DAYS=30
RETENTION_RAW_LLM_RESPONSES_DAYS=14
RETENTION_FULL_PROMPTS_DAYS=14
RETENTION_AUDIT_DAYS=365
# Owner must set recovery objectives in seconds (zero deliberately fails validation).
FAILOVER_RPO_TARGET_SECONDS=0
FAILOVER_RTO_TARGET_SECONDS=0
