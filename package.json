{
  "name": "biz-req-researcher",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "predev": "node ./scripts/free-dev-ports.mjs",
    "dev": "NODE_ENV=development concurrently -n server,client -c green,blue \"npm -w server run dev\" \"npm -w client run dev\"",
    "build": "npm -w client run build",
    "start": "NODE_ENV=production npm -w server run start",
    "fix:links": "node scripts/fix-workspace-links.mjs",
    "postinstall": "node scripts/fix-workspace-links.mjs",
    "qualify:load": "node scripts/qualification/load.mjs",
    "qualify:security": "node scripts/qualification/security.mjs",
    "qualify:drill": "node scripts/qualification/drill.mjs",
    "qualify:soak": "node scripts/qualification/soak.mjs",
    "qualify:failover": "node scripts/qualification/failover.mjs",
    "qualify:rollout-gate": "node scripts/qualification/rollout-gate.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
