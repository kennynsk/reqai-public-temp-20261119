## Этот пример можно копировать в / .env.dev или / .env.prod
## и заполнять значениями для нужного этапа.
## Полный enterprise-каталог, defaults и правила владения:
## docs/configuration.md

## Опционально
PORT=5178
# Если PORT занят, сервер попробует следующие порты (PORT+1, PORT+2, ...)
# до значения PORT_RETRY_LIMIT.
# PORT_RETRY_LIMIT=20
## Z.AI (GLM)
ZAI_API_KEY=your_zai_api_key_here
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_MODELS=glm-5.3-flash,glm-5.3,glm-5.2,glm-5-turbo,glm-4.7,glm-4.7-flash

## GigaChat (для физлиц)
# Вариант 1: Готовый Base64 ключ (client_id:client_secret в Base64)
# GIGACHAT_AUTH_KEY=your_base64_encoded_auth_key_here
# Вариант 2: Отдельные client_id и client_secret (будут автоматически закодированы)
# GIGACHAT_CLIENT_ID=your_client_id_here
# GIGACHAT_CLIENT_SECRET=your_client_secret_here
# GIGACHAT_ACCESS_TOKEN=your_gigachat_access_token_here
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_CA_CERT_PATH=/absolute/path/to/russiantrustedca.pem
# GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_MODELS=GigaChat-2,GigaChat-2-Pro,GigaChat-2-Max

## GigaChat Corp (для ИП/юрлиц, внутрикорпоративный)
## Использует официальную библиотеку gigachat-js (npm: gigachat).
## Авторизация: credentials, user/password, mTLS-сертификаты или accessToken.
## Имена моделей — как у GigaChat API (например GigaChat-2-Max), без префикса CORP.
## Распознаются устаревшие варианты с префиксом «CORP » или суффиксом -Corp.
# GIGACHAT_CORP_CREDENTIALS=your_authorization_key_here
# GIGACHAT_CORP_SCOPE=GIGACHAT_API_CORP
# GIGACHAT_CORP_USER=your_username
# GIGACHAT_CORP_PASSWORD=your_password
# GIGACHAT_CORP_ACCESS_TOKEN=your_access_token_here
# GIGACHAT_CORP_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# GIGACHAT_CORP_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_CORP_TIMEOUT=600
## mTLS-сертификаты (для подключения по клиентскому сертификату):
# GIGACHAT_CORP_CA_CERT_PATH=/path/to/ca.pem
# GIGACHAT_CORP_TLS_CERT_PATH=/path/to/tls.pem
# GIGACHAT_CORP_TLS_KEY_PATH=/path/to/tls.key
# GIGACHAT_CORP_TLS_KEY_PASSPHRASE=your_private_key_passphrase
## Отключить проверку корневого сертификата (не рекомендуется для production):
# GIGACHAT_CORP_REJECT_UNAUTHORIZED=false
## Модели (реальные имена для API):
# GIGACHAT_CORP_MODELS=GigaChat-2,GigaChat-2-Pro,GigaChat-2-Max

## Enterprise async platform (необходимы после включения /api/v1)
# DEPLOYMENT_SITE_ID=dc-a
# DEFAULT_TENANT_ID=default-enterprise
# DATABASE_URL=postgresql://reqai:password@postgres:5432/reqai
# KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
# TEMPORAL_ADDRESS=temporal:7233
# TEMPORAL_NAMESPACE=reqai
# TBD Temporal/mTLS: согласовать worker identity, build ID, server name и certificate mount paths.
# TEMPORAL_WORKER_IDENTITY=reqai-workflow-worker-dc-a
# TEMPORAL_WORKFLOW_BUILD_ID=reqai-v1
# TEMPORAL_WORKER_TASK_QUEUE=requirements-decomposition
# TEMPORAL_TLS_ENABLED=true
# TEMPORAL_TLS_CERT_PATH=/var/run/secrets/temporal/tls.crt
# TEMPORAL_TLS_KEY_PATH=/var/run/secrets/temporal/tls.key
# TEMPORAL_TLS_CA_CERT_PATH=/var/run/secrets/temporal/ca.crt
# TEMPORAL_TLS_SERVER_NAME=temporal.internal
# LLM_PROVIDER_MODE=zai
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# ZAI_MODELS=glm-5.3-flash,glm-5.3,glm-5.2,glm-5-turbo,glm-4.7,glm-4.7-flash
# Необязательно: максимум три модели на один шаг; по умолчанию берутся первые три из ZAI_MODELS.
# LLM_MODEL_PRIORITY=glm-5.3-flash,glm-5.3,glm-5.2
# Таймаут одной попытки provider-вызова: 10 минут.
# LLM_REQUEST_TIMEOUT_MS=600000
# TBD chunking: откалибровать относительно подтвержденных context limits и качества результатов.
# LLM_CHUNK_TARGET_TOKENS=60000
# LLM_CHUNK_CONCURRENCY=3
# TBD capacity: откалибровать admission/backlog/priority после production-like load test.
# ADMISSION_MAX_JOBS_PER_MINUTE=30
# ADMISSION_MAX_ACTIVE_JOBS_PER_USER=5
# QUEUE_SOFT_BACKLOG_LIMIT=1000
# QUEUE_HARD_BACKLOG_LIMIT=5000
# DECOMPOSITION_QUEUE_PRIORITY=100
# RESEARCH_QUEUE_PRIORITY=50
# TBD: заменить provisional-квоты на подтверждённые платформой значения.
# LLM_MODEL_RPM_JSON={"glm-5.3-flash":30,"glm-5.3":30,"glm-5.2":30,"glm-5-turbo":30,"glm-4.7":30,"glm-4.7-flash":30}
# LLM_MODEL_TPM_JSON={"glm-5.3-flash":1000000,"glm-5.3":1000000,"glm-5.2":1000000,"glm-5-turbo":1000000,"glm-4.7":1000000,"glm-4.7-flash":1000000}
# LLM_MODEL_CONTEXT_TOKENS_JSON={"glm-5.3-flash":128000,"glm-5.3":128000,"glm-5.2":128000,"glm-5-turbo":128000,"glm-4.7":128000,"glm-4.7-flash":128000}
# LLM_MODEL_OUTPUT_TOKENS_JSON={"glm-5.3-flash":32000,"glm-5.3":32000,"glm-5.2":32000,"glm-5-turbo":32000,"glm-4.7":32000,"glm-4.7-flash":32000}
# BABOK decomposition experiment: disable app-level reasoning by default and cap each response at 16k tokens.
# GLM-5.3/GLM-5.3-Flash require thinking; app-level "disabled" is sent as minimum reasoning_effort=low.
# LLM_DECOMPOSITION_THINKING=disabled
# LLM_DECOMPOSITION_OUTPUT_TOKENS_JSON={"glm-5.3-flash":16000,"glm-5.3":16000,"glm-5.2":16000,"glm-5-turbo":16000,"glm-4.7":16000,"glm-4.7-flash":16000}
# LLM_MODEL_MAX_CONCURRENCY_JSON={"glm-5.3-flash":5,"glm-5.3":5,"glm-5.2":5,"glm-5-turbo":5,"glm-4.7":5,"glm-4.7-flash":5}
# TBD IAM/NGAM: production должен переопределить example.invalid и claim mappings.
# IAM_ISSUER=https://iam.example.invalid
# IAM_AUDIENCE=reqai
# IAM_JWKS_URI=https://iam.example.invalid/.well-known/jwks.json
# IAM_USER_ID_CLAIM=sub
# IAM_ROLES_CLAIM=roles
# IAM_TENANT_CLAIM=tenant_id
# JOB_INPUT_MAX_BYTES=104857600

# Additive domain integration API; canonical /api/v1/jobs remains available when disabled.
# REQUIREMENTS_INTEGRATION_API_ENABLED=true
# Contextual requirement discussions are additive; disabling the flag hides only discussion endpoints and entry points.
# REQUIREMENT_DISCUSSION_ENABLED=true
# DISCUSSION_MESSAGE_MAX_CHARS=12000
# DISCUSSION_CONTEXT_MAX_BYTES=120000
# DISCUSSION_OUTPUT_MAX_CHARS=30000
# DISCUSSION_HISTORY_MESSAGES=40
# DISCUSSION_MAX_CHANGES=20
# DISCUSSION_PROMPT_VERSION=1.0.0
# VERSIONED_PROMPTS_ENABLED=true
# PROMPT_MAX_RENDERED_BYTES=2097152
# PROMPT_DECOMPOSITION_ACTIVE_VERSION=2.3.0
# PROMPT_DECOMPOSITION_ACTIVE_VERSION=2.17.0
# PROMPT_DECOMPOSITION_RELEASED_VERSIONS=1.0.0,2.0.0,2.1.0,2.2.0,2.3.0
# PROMPT_REQUIREMENTS_INSIGHTS_ACTIVE_VERSION=2.1.0
# PROMPT_REQUIREMENTS_INSIGHTS_RELEASED_VERSIONS=1.0.0,2.0.0,2.1.0
# SKILL_BABOK_REQUIREMENTS_ACTIVE_VERSION=1.1.0
# SKILL_BABOK_REQUIREMENTS_RELEASED_VERSIONS=1.0.0,1.1.0
# JOB_RESULT_MAX_BYTES=104857600
# WEBHOOK_ENABLED=false
# TBD retention cadence: согласовать maintenance window и допустимую DB-нагрузку.
# RETENTION_CLEANUP_INTERVAL_MS=3600000
# RETENTION_CLEANUP_BATCH_SIZE=500
# Bounded metadata indexing for legacy jobs; the maintenance worker runs it immediately and on this cadence.
# JOB_METADATA_BACKFILL_INTERVAL_MS=300000
# JOB_METADATA_BACKFILL_BATCH_SIZE=100
